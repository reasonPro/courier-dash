      "status": "reported_pending_snapshot",
      "input": {
        "sources": [
          {
            "source": "manual",
            "sourceRecordId": "synthetic-manual-fuel-1",
            "category": "fuel",
            "amount": "75.00"
          },
          {
            "source": "garage",
            "sourceRecordId": "synthetic-garage-routine-1",
            "garageServiceType": "routine",
            "category": "maintenance",
            "amount": "125.00"
          },
          {
            "source": "garage",
            "sourceRecordId": "synthetic-garage-repair-1",
            "garageServiceType": "repair",
            "category": "repair",
            "amount": "200.00"
          }
        ],
        "attemptedManualDuplicate": {
          "sourceGarageRecordId": "synthetic-garage-repair-1",
          "category": "repair",
          "amount": "200.00"
        }
      },
      "expected": {
        "recordedExpenses": "400.00",
        "uniqueSourceReferences": 3,
        "copiedGarageRowsInManualExpenses": 0,
        "manualDuplicateAllowed": false,
        "garageCorrectionOwner": "garage"
      },
      "explanation": "Expenses references Garage history as a separate source; Garage-derived expenses are created or corrected in Garage, never copied into manual rows.",
