      "introduced": "0.3.0-draft"
    },
    {
      "ruleId": "EXP-MONEY-001",
      "caseId": "expense-amount-boundaries",
      "title": "Expense amount boundaries and decimal scale",
      "status": "verified",
      "input": {
        "accepted": ["0.01", "999999.99"],
        "rejected": ["0.00", "1000000.00", "1.001", "-0.01"]
      },
      "expected": {
        "minimum": "0.01",
        "maximum": "999999.99",
        "decimalPlacesMaximum": "2",
        "currency": "PLN"
      },
      "explanation": "Amounts use exact decimal strings and are rejected rather than rounded into range.",
      "verifiedAgainst": ["lib/expenses-prototype.ts", "supabase/migrations/202608140001_limit_expenses_amount.sql"],
      "evidenceRefs": ["docs/shared/EXPENSES_CONTRACT.md#money-rules"],
      "introduced": "0.3.0-draft"
    },
    {
      "ruleId": "EXP-CALCULATION-MODES-001",
      "caseId": "expense-four-calculation-modes",
      "title": "BRUTTO and NETTO subtract recorded expenses once",
      "status": "verified",
      "input": {
        "gross": "5000.00",
        "taxAndFees": "600.00",
        "recordedExpenses": "800.00"
      },
      "expected": {
        "gross": "5000.00",
        "after_tax_and_fees": "4400.00",
        "after_recorded_expenses": "4200.00",
        "after_all_deductions": "3600.00"
      },
      "explanation": "G includes all recorded income; E is subtracted once and T is used only in tax-dependent modes.",
      "verifiedAgainst": ["lib/after-expenses.ts", "lib/work-finance.ts"],
      "evidenceRefs": ["tests/expenses-work-summary.test.ts"],
      "introduced": "0.3.0-draft"
    },
    {
      "ruleId": "EXP-RENTAL-001",
      "caseId": "rental-payment-month-attribution",
      "title": "Rental is counted in the payment month only",
      "status": "verified",
      "input": {
        "amount": "700.00",
        "expenseDate": "2026-08-28",
        "paidPeriodFrom": "2026-08-28",
        "paidPeriodTo": "2026-09-03"
      },
      "expected": {
        "augustTotal": "700.00",
        "septemberTotal": "0.00",
        "paidPeriodInclusive": true,
        "proration": false
      },
      "explanation": "The paid period is descriptive; the full payment is attributed by expenseDate.",
      "verifiedAgainst": ["lib/expenses-prototype.ts"],
      "evidenceRefs": ["tests/expenses-prototype.test.ts"],
      "introduced": "0.3.0-draft"
    },
    {
      "ruleId": "EXP-DATE-001",
      "caseId": "backdated-expense-uses-actual-date",
      "title": "Backdated entries use expense date rather than creation time",
      "status": "verified",
      "input": {
        "expenseDate": "2026-07-31",
        "createdAt": "2026-08-10T10:00:00.000Z",
        "amount": "25.50"
      },
      "expected": {
        "attributedMonth": "2026-07",
        "createdAtUsedForAttribution": false,
        "utcDateConversionAllowed": false
      },
      "explanation": "Calendar-date filters and totals use the user's actual expense date.",
