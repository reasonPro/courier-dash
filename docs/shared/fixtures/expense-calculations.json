      "caseId": "expense-result-availability-vocabulary",
      "title": "Calculation results expose owner-approved completeness behavior",
      "status": "reported_pending_snapshot",
      "input": {
        "scenarios": ["complete", "partial", "tax-dependent-without-reliable-t"]
      },
      "expected": {
        "states": ["available", "partial", "unavailable", "not_configured"],
        "complete": {
          "availability": "available",
          "value": "850.00",
          "missingComponents": [],
          "isFinal": true
        },
        "partial": {
          "availability": "partial",
          "value": null,
          "missingComponents": ["recordedExpenses"],
          "isFinal": false
        },
        "taxDependentWithoutReliableT": {
          "availability": "not_configured",
          "value": null,
          "missingComponents": ["taxAndFees"],
          "isFinal": false,
          "availableAllowed": false
        }
      },
      "explanation": "Partial results disclose at least one missing component and are never final; T-dependent modes cannot be available without reliable T.",
      "verifiedAgainst": ["owner-approved:DEC-025:2026-08-10"],
      "evidenceRefs": ["docs/shared/EXPENSES_CONTRACT.md", "docs/shared/types/expenses.ts"],
