    {
      "ruleId": "EXP-AVAILABILITY-001",
      "caseId": "expense-read-failure-is-unavailable",
      "title": "Failed Expenses reads never become zero",
      "status": "verified",
      "input": {
        "gross": "5000.00",
        "expensesRead": "failed",
        "taxConfigured": false
      },
      "expected": {
        "afterRecordedExpenses": null,
        "afterRecordedExpensesAvailability": "unavailable",
        "afterAllDeductions": null,
        "afterAllDeductionsAvailability": "unavailable",
        "silentZeroAllowed": false,
        "missingComponents": ["recordedExpenses"]
      },
      "explanation": "A remote read failure is not the same as a successful empty result; unknown tax also remains unavailable.",
      "verifiedAgainst": ["lib/use-expenses.ts", "app/expenses/components/AfterExpensesResult.tsx"],
      "evidenceRefs": ["docs/shared/EXPENSES_CONTRACT.md#availability-and-failure-behavior"],
