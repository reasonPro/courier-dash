      "caseId": "rental-non-terminating-proration-round-half-up",
      "title": "Rental proration keeps a non-terminating rational exact until final rounding",
      "status": "reported_pending_snapshot",
      "input": {
        "weeklyAmount": "100.00",
        "activeCalendarDays": "1",
        "daysPerWeek": "7"
      },
      "expected": {
        "minorUnitNumerator": "10000",
        "minorUnitDenominator": "7",
        "intermediateRounding": false,
        "finalAmount": "14.29",
